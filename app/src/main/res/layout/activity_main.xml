<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="문자 인증번호 연결 설정"
            android:textSize="22sp" />
        <EditText
            android:id="@+id/host_address_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="서버 주소 (예: sms.netras.org)"
            android:inputType="textUri"
            android:singleLine="true" />
        <EditText
            android:id="@+id/pairing_key_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="연결키 (PC와 동일하게 입력)"
            android:inputType="textPassword"
            android:singleLine="true"
            android:importantForAutofill="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="설정은 자동 저장됩니다. 연결키는 숫자나 문자를 사용해 공백 없이 4~128자로 정하세요. PC에도 똑같이 입력하면 문자를 받을 수 있습니다." />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/background_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="백그라운드 실행 허용" />
        <TextView
            android:id="@+id/background_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="서버 주소와 연결키를 설정하고 문자 권한을 허용하면 자동 전달됩니다. 이 스위치는 배터리 최적화 제외 상태를 표시하며, 끄려면 시스템 설정에서 변경하세요." />
        <Button
            android:id="@+id/allow_auto_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="휴대폰 자동 열기 권한 설정" />
        <TextView
            android:id="@+id/search_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PC에서 모델명을 보내면 9tems 검색 결과를 엽니다. 다른 앱 위에 표시 권한이 필요합니다. 화면이 켜져 있고 잠금이 풀려 있으면 바로 열고, 잠겨 있거나 꺼져 있을 때만 검색 알림을 표시합니다." />
        <Button
            android:id="@+id/test_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="연결 테스트" />
    </LinearLayout>
</ScrollView>
